# ==============================================================================
# ASTRO COMMAND - Environment Configuration
# Copy this file to .env and configure your keys
# ==============================================================================

# NASA Open APIs
# Get your free key at https://api.nasa.gov (Defaults to DEMO_KEY if left empty)
NASA_API_KEY=DEMO_KEY

# Supabase Database Configuration
# Create a free project at https://supabase.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Companions & Advisors (Optional)
# Gemini 1.5 Flash (https://aistudio.google.com)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# OpenAI (Optional fallback)
OPENAI_API_KEY=
